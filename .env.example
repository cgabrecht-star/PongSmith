# Anthropic Claude API
ANTHROPIC_API_KEY=

# Supabase PostgreSQL (Transaction Mode: Port 6543)
DATABASE_URL=

# Plausible Analytics (optional, nur Prod)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pongsmith.de
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# Affiliate-IDs (NICHT geheim — erscheinen in jedem Outbound-Link)
# Amazon Partnernet — Tracking-ID
AFFILIATE_AMAZON_TAG=pongsmith-21
# Awin — Publisher-ID
AFFILIATE_AWIN_PUBLISHER_ID=2883847
# Adcell — Publisher-ID (eindeutige 6-stellige Zahl aus Adcell-Dashboard)
AFFILIATE_ADCELL_PUBLISHER_ID=
# Adcell — Promo-IDs pro Advertiser (kommen aus dem jeweiligen Programm
# nach Genehmigung, sind eindeutige IDs für Tracking-Links)
AFFILIATE_ADCELL_PROMO_TT_SHOP=
AFFILIATE_ADCELL_PROMO_TISCHTENNIS_BIZ=

# Google Search Console — Verification-Token (HTML-Tag-Methode)
# Erhältst du in der Search Console wenn du eine neue Property anlegst
GOOGLE_SITE_VERIFICATION=
